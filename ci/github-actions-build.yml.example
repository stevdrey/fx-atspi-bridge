name: Build and test
on:
  push:
  pull_request:
permissions:
  contents: read
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: actions/setup-java@cf277c60eb25467037889841efdb72551f06f6c3 # v4
        with:
          distribution: temurin
          java-version: '27'
      - name: Install GLib for native unit tests
        run: sudo apt-get update && sudo apt-get install -y libglib2.0-0t64
      - name: Build library and example; test native variants and Unicode offsets
        run: ./gradlew build generatePomFileForMavenJavaPublication --no-daemon
