{
  "name": "Allow trusted PR publication guard event",
  "enforcement": "active",
  "conditions": {
    "workflow_path": {
      "include": [".github/workflows/trusted-pr-size-guard.yml"],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "restrict_action_events",
      "parameters": {
        "allowed_events": ["pull_request_target"]
      }
    }
  ]
}
